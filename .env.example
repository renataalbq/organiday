# Supabase → Project Settings → API (ou "Connect")
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sua-chave-publishable-ou-anon

# Só no servidor (Vercel → Environment Variables), nunca com prefixo VITE_.
# Criptografa os tokens do Jira, Trello e Asana. Gere com: openssl rand -base64 32
ORGANIDAY_SECRET_KEY=

# Lembretes (web push). Gere o par com: npx web-push generate-vapid-keys
# (a pública não precisa de VITE_: o app busca em /api/push-public-key)
VAPID_PUBLIC_KEY=
# Só no servidor:
VAPID_PRIVATE_KEY=
# segredo que o pg_cron do Supabase manda pra /api/send-reminders (gere com: openssl rand -hex 24)
CRON_SECRET=
# Supabase → Project Settings → API Keys → Secret key (sb_secret_…), ou a service_role antiga. Só servidor.
SUPABASE_SERVICE_ROLE_KEY=
